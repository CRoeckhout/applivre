{
  "name": "grimolia",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start --device",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_VARIANT=development expo run:android --device",
    "ios": "APP_VARIANT=development expo run:ios --device",
    "build:ios": "expo run:ios --device --configuration Release",
    "build:android": "expo run:android --device --variant release",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "social:sync": "node ./scripts/sync-social-migrations.mjs"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo-google-fonts/unifrakturmaguntia": "^0.4.1",
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "^15.0.3",
    "@grimolia/social": "workspace:*",
    "@lottiefiles/dotlottie-react": "^0.19.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.99.2",
    "base64-arraybuffer": "^1.0.2",
    "canvaskit-wasm": "0.40.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "fast-xml-parser": "^5.7.1",
    "grimolia-live-activity": "link:./modules/live-activity",
    "grimolia-media-remote-commands": "link:./modules/media-remote-commands",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-wheel-color-picker": "^1.3.1",
    "react-native-worklets": "0.10.1",
    "tslib": "^2.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@react-native/metro-config": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  },
  "private": true
}
